# The provider you want to use by default: "Google (Gemini)" or "OpenAI"
DEFAULT_PROVIDER="Google (Gemini)"

# Your Google API Key (starts with AIza...)
GOOGLE_API_KEY=""
# Which model to default to (e.g. gemini-2.5-flash, gemini-1.5-pro)
GOOGLE_MODEL="gemini-2.5-flash"

# Your OpenAI API Key (starts with sk-...)
OPENAI_API_KEY=""
# Which model to default to (e.g. gpt-4o, gpt-4o-mini)
OPENAI_MODEL="gpt-4o"
